# Django设置
DJANGO_ENV=development  # development, production, testing
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=backend.settings.development

# 数据库配置
# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=zeroislenotes
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=30000

# Neo4j配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=100

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100
REDIS_TIMEOUT=300

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# 邮件配置
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@zeroislenotes.com
EMAIL_TIMEOUT=30

# JWT配置
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=1  # 小时
JWT_REFRESH_TOKEN_LIFETIME=7  # 天
JWT_ALLOW_REFRESH=True
JWT_REFRESH_EXPIRATION_DELTA=7  # 天

# 文件存储
MEDIA_ROOT=media
STATIC_ROOT=static
MEDIA_URL=/media/
STATIC_URL=/static/
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB
FILE_UPLOAD_TEMP_DIR=temp
FILE_UPLOAD_PERMISSIONS=0o644

# 第三方服务配置
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key

# AI配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo  # 或 gpt-4
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key
XUNFEI_APP_ID=your-xunfei-app-id
XUNFEI_API_KEY=your-xunfei-api-key
XUNFEI_API_SECRET=your-xunfei-api-secret

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/backend.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# 安全配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Strict
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Strict
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
X_FRAME_OPTIONS=SAMEORIGIN

# 性能配置
CACHE_TIMEOUT=300
CACHE_MAX_ENTRIES=1000
CACHE_CULL_FREQUENCY=3
RATE_LIMIT=100
RATE_LIMIT_WINDOW=60
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# 应用配置
APP_NAME=知识笔记
APP_VERSION=1.0.0
APP_DESCRIPTION=知识管理与笔记应用
APP_AUTHOR=Your Name
APP_EMAIL=your-email@example.com
APP_URL=https://zeroislenotes.com
APP_LICENSE=MIT
APP_COPYRIGHT=© 2024 ZeroIsle Notes

