# Django设置
DJANGO_ENV=development  # development, production, testing
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=backend.settings.development

# 数据库设置
# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=zeroislenotes

# Neo4j设置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis设置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery设置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False  # 开发环境可设为True，避免启动Celery worker

# 邮件设置
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@zeroislenotes.com

# JWT设置
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=1  # 小时
JWT_REFRESH_TOKEN_LIFETIME=7  # 天

# 文件存储
MEDIA_ROOT=media
STATIC_ROOT=static
MEDIA_URL=/media/
STATIC_URL=/static/

# 第三方服务
SMS_API_KEY=your-sms-api-key
SMS_API_SECRET=your-sms-api-secret
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
QQ_APP_ID=your-qq-app-id
QQ_APP_KEY=your-qq-app-key

# AI服务
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo  # 或 gpt-4
BAIDU_API_KEY=your-baidu-api-key
BAIDU_SECRET_KEY=your-baidu-secret-key
XUNFEI_APP_ID=your-xunfei-app-id
XUNFEI_API_KEY=your-xunfei-api-key
XUNFEI_API_SECRET=your-xunfei-api-secret

# 日志设置
LOG_LEVEL=INFO
LOG_FILE=logs/backend.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# 跨域设置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=True

# 应用设置
APP_NAME=零屿笔记
APP_VERSION=1.0.0
APP_DESCRIPTION=知识管理与笔记应用
APP_CONTACT_EMAIL=support@zeroislenotes.com
