# MongoDB Realm/Atlas配置示例
# 复制此文件为.env.realm并填写相应的值

# MongoDB Atlas连接配置
MONGO_URI=
MONGO_DB=ZeroIsle_Notes
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=30000

# MongoDB Realm/Atlas App Services配置
REALM_APP_ID=your-realm-app-id
REALM_API_KEY=your-realm-api-key
REALM_GROUP_ID=your-realm-group-id
REALM_GROUP_NAME=your-realm-group-name
REALM_USERNAME=your-realm-username
REALM_PASSWORD=your-realm-password

# MongoDB Realm/Atlas App Services同步配置
REALM_SYNC_ENABLED=true
REALM_SYNC_MODE=manual # realtime, manual
REALM_SYNC_INTERVAL=300 # 秒
REALM_SYNC_CONFLICT_RESOLUTION=client_wins # client_wins, server_wins
REALM_SYNC_PARTITION_STRATEGY=user # user, flexible

# MongoDB Realm/Atlas App Services认证配置
REALM_AUTH_PROVIDERS=email-password,function
REALM_AUTH_ANON_ENABLED=false
REALM_AUTH_EMAIL_PASSWORD_ENABLED=true
REALM_AUTH_FUNCTION_ENABLED=true
REALM_AUTH_JWT_ENABLED=false

# MongoDB Realm/Atlas App Services函数配置
REALM_FUNCTION_LOGIN=login
REALM_FUNCTION_REGISTER=register
REALM_FUNCTION_SYNC_DATA=syncData

# MongoDB Realm/Atlas App Services日志配置
REALM_LOG_LEVEL=info # debug, info, warn, error
