  "private": true,
  "scripts": {
    "android": "node node_modules/react-native/cli.js run-android",
    "ios": "node node_modules/react-native/cli.js run-ios",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "start": "node node_modules/react-native/cli.js start",
    "local:web": "node scripts/serve-local-web.js",
    "test": "node node_modules/jest/bin/jest.js",
    "test:e2e:jest": "node node_modules/jest/bin/jest.js --config e2e/jest.config.js",
    "bundle:verify": "node node_modules/react-native/cli.js bundle --platform android --dev false --entry-file index.js --bundle-output tmp/bundle-verify.android.js --assets-dest tmp/bundle-verify-assets",
    "detox:test:android": "node node_modules/detox/local-cli/cli.js test -c android.emu.debug",
    "detox:build:android": "node node_modules/detox/local-cli/cli.js build -c android.emu.debug",
    "detox:smoke:android": "node node_modules/detox/local-cli/cli.js test -c android.emu.debug --testNamePattern=\"Smoke\"",
    "detox:build:android:attached": "node node_modules/detox/local-cli/cli.js build -c android.att.debug",
    "detox:smoke:android:attached": "node node_modules/detox/local-cli/cli.js test -c android.att.debug --testNamePattern=\"Smoke\"",
    "test:mindmap:view": "jest src/tests/mindMapView.accessibility.test.js --watch=false",
    "install-deps": "npm install --registry=https://registry.npmmirror.com",
    "install-deps-yarn": "yarn --registry=https://registry.npmmirror.com",
    "pod-install": "cd ios && pod install",
    "postinstall": "npx jetify && node patch-bcrypt.js && node node_modules/patch-package/index.js",
    "clear-cache": "node node_modules/react-native/cli.js start --reset-cache",
    "patch-bcrypt": "node patch-bcrypt.js",
    "dist": "electron-builder"
  },
