# ZeroIsle Notes - Production Environment Variables
# Copy this file to .env.production and fill in the values

# --- General ---
DEBUG=False
DJANGO_ENV=production
DJANGO_SECRET_KEY=__CHANGE_ME_TO_A_VERY_SECURE_RANDOM_STRING__
ALLOWED_HOSTS=api.zeroislenotes.com,www.zeroislenotes.com

# --- Database (MongoDB) ---
MONGO_URI=mongodb://root:__MONGO_PASSWORD__@mongodb:27017/zeroisle_prod?authSource=admin
MONGO_DB=zeroisle_prod
MONGO_USER=root
MONGO_PASSWORD=__CHANGE_ME__

# --- Monitoring ---
SENTRY_DSN=

# --- Task Queue (Celery) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Knowledge Graph (Neo4j) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__CHANGE_ME__

# --- Cache (Redis) ---
REDIS_URL=redis://redis:6379/1

# --- Email (SMTP) ---
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=__SENDGRID_API_KEY__
DEFAULT_FROM_EMAIL=noreply@zeroislenotes.com

# --- AI Services ---
OPENAI_API_KEY=__OPTIONAL__
VECTOR_MODEL_TYPE=sentence_transformer

# --- Security ---
# 管理后台 IP 白名单（逗号分隔的 IP / CIDR / 末段通配）
# 未配置 = 不限制来源（中间件会打 WARNING）；生产环境应显式配置。
# 示例：ADMIN_ALLOWLIST_IPS=127.0.0.1,10.0.0.0/8,192.168.1.*
ADMIN_ALLOWLIST_IPS=127.0.0.1

# 可信反向代理层数，用于从 X-Forwarded-For 右侧取真实客户端 IP。
# 默认 1（即最右侧那一段是客户端）。设为 0 时改用左侧第一段 ——
# 只有在服务不直接暴露公网时才安全，否则可被伪造 XFF 绕过白名单。
ADMIN_TRUSTED_PROXY_COUNT=1

# 管理后台允许的跨域来源（逗号分隔）。未设置时仅允许本机开发来源。
# 例如：ADMIN_CORS_ALLOWED_ORIGINS=https://admin.zeroislenotes.com
ADMIN_CORS_ALLOWED_ORIGINS=

# 仅开发环境使用：设为 1 时放开所有跨域来源（生产切勿设置）
ADMIN_CORS_ALLOW_ALL=

# --- Social Auth ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Payments ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.zeroislenotes.com/payment/webhook/wechat
