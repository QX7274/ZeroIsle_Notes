# ZeroIsle Notes - Production Environment Variables
# Copy this file to .env.production and fill in the values

# --- General ---
DEBUG=False
DJANGO_ENV=production
DJANGO_SECRET_KEY=__CHANGE_ME_TO_A_VERY_SECURE_RANDOM_STRING__
ALLOWED_HOSTS=api.zeroislenotes.com,www.zeroislenotes.com

# --- Database (MongoDB) ---
MONGODB_URI=mongodb://root:__MONGO_PASSWORD__@mongodb:27017/zeroisle_prod?authSource=admin
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=__CHANGE_ME__

# --- Monitoring ---
SENTRY_DSN=

# --- Task Queue (Celery) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Knowledge Graph (Neo4j) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=__CHANGE_ME__

# --- Cache (Redis) ---
REDIS_URL=redis://redis:6379/1

# --- Email (SMTP) ---
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=__SENDGRID_API_KEY__
DEFAULT_FROM_EMAIL=noreply@zeroislenotes.com

# --- AI Services ---
OPENAI_API_KEY=__OPTIONAL__
VECTOR_MODEL_TYPE=sentence_transformer

# --- Security ---
# Comma separated list of allowed IPs for Admin API
ADMIN_ALLOWLIST_IPS=127.0.0.1

# --- Social Auth ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --- Payments ---
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
WECHAT_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.zeroislenotes.com/payment/webhook/wechat

