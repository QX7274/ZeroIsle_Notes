# 零屿笔记应用环境变量配置示例
# 复制此文件为.env并填写相应的值

# 应用配置
APP_NAME=零屿笔记
APP_VERSION=1.0.0
APP_ENV=development # development, production, testing

# API配置
API_URL=http://localhost:8000
API_VERSION=v1
API_TIMEOUT=30000

# MongoDB Realm/Atlas配置
REALM_APP_ID=your-realm-app-id
REALM_API_KEY=your-realm-api-key
REALM_SERVICE_URL=https://realm.mongodb.com
REALM_REGION=us-east-1
REALM_SYNC_ENABLED=true
REALM_SYNC_MODE=manual # realtime, manual
REALM_SYNC_INTERVAL=300000
REALM_SYNC_CONFLICT_RESOLUTION=client_wins # client_wins, server_wins
REALM_SYNC_PARTITION_STRATEGY=user # user, flexible
REALM_AUTH_PROVIDERS=email-password,function
REALM_AUTH_ANON_ENABLED=false
REALM_AUTH_EMAIL_PASSWORD_ENABLED=true
REALM_AUTH_FUNCTION_ENABLED=true
REALM_AUTH_JWT_ENABLED=false
REALM_FUNCTION_LOGIN=login
REALM_FUNCTION_REGISTER=register
REALM_FUNCTION_SYNC_DATA=syncData

# 日志配置
LOG_LEVEL=info # debug, info, warn, error

# 文件存储配置
FILE_STORAGE=local # local, s3, azure, gcp
FILE_STORAGE_PATH=./storage
FILE_STORAGE_URL=http://localhost:8000/storage

# 缓存配置
CACHE_ENABLED=true
CACHE_TTL=3600

# 安全配置
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=86400
ENCRYPTION_KEY=your-encryption-key

# 第三方服务配置
# Firebase
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# 微信
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# QQ
QQ_APP_ID=your-qq-app-id
QQ_APP_SECRET=your-qq-app-secret

# 邮件服务
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=your-mail-password
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=零屿笔记

# 短信服务
SMS_PROVIDER=aliyun # aliyun, tencent, netease
SMS_ACCESS_KEY=your-sms-access-key
SMS_SECRET_KEY=your-sms-secret-key
SMS_SIGN_NAME=零屿笔记
SMS_TEMPLATE_CODE=your-sms-template-code

# 支付服务
PAYMENT_PROVIDER=alipay # alipay, wechat, stripe
PAYMENT_APP_ID=your-payment-app-id
PAYMENT_PRIVATE_KEY=your-payment-private-key
PAYMENT_PUBLIC_KEY=your-payment-public-key
PAYMENT_NOTIFY_URL=http://localhost:8000/api/v1/payment/notify

# AI服务
AI_PROVIDER=openai # openai, azure, huggingface
AI_API_KEY=your-ai-api-key
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
